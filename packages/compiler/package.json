{
  "name": "@gati/compiler",
  "version": "1.0.0",
  "description": "Ahead-of-Time template & TSX parser, AIR intermediate representation generator, and static template hoister.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
