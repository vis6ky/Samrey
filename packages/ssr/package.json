{
  "name": "@samrey/ssr",
  "version": "1.0.0",
  "description": "Streaming HTML server-side renderer, Unicode-safe state serializer, and resumable hydration delegator for Samrey.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samrey-framework/samrey.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://samrey.dev",
  "bugs": {
    "url": "https://github.com/samrey-framework/samrey/issues"
  },
  "keywords": [
    "samrey",
    "ssr",
    "streaming",
    "hydration",
    "serializer"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@samrey/reactivity": "^1.0.0",
    "@samrey/security": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
