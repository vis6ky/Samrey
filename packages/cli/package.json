{
  "name": "@aether/cli",
  "version": "0.1.0",
  "description": "Command-line tool, Vite plugin integration, and static security/a11y auditor for Aether applications.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "aether": "./bin/aether.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aether/compiler": "^0.1.0"
  },
  "keywords": ["aether", "cli", "vite-plugin", "bundler", "auditor"],
  "author": "Aether Framework Team",
  "license": "Apache-2.0"
}
