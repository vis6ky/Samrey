{
  "name": "@aether/cli",
  "version": "1.0.0",
  "description": "Command-line tool, Vite plugin integration, and static security/a11y auditor for Aether applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aether-framework/aether.git",
    "directory": "packages/cli"
  },
  "homepage": "https://aether.dev",
  "bugs": {
    "url": "https://github.com/aether-framework/aether/issues"
  },
  "keywords": [
    "aether",
    "cli",
    "vite-plugin",
    "bundler",
    "auditor"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=bin/aether.js",
    "prepack": "npm run build"
  },
  "bin": {
    "aether": "./bin/aether.js"
  },
  "dependencies": {
    "@aether/compiler": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
