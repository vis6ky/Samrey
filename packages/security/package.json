{
  "name": "@samrey/security",
  "version": "1.0.0",
  "description": "Contextual HTML/URI sanitizer, W3C Trusted Types policy provider, and anti-CSRF token utilities for Samrey.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vis6ky/Samrey.git",
    "directory": "packages/security"
  },
  "homepage": "https://github.com/vis6ky/Samrey#readme",
  "bugs": {
    "url": "https://github.com/vis6ky/Samrey/issues"
  },
  "keywords": [
    "samrey",
    "security",
    "trusted-types",
    "sanitizer",
    "csrf",
    "xss"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
