    "directory": "packages/security"
  },
  "homepage": "https://aether.dev",
  "bugs": {
    "url": "https://github.com/aether-framework/aether/issues"
  },
  "keywords": [
    "aether",
    "security",
    "trusted-types",
    "sanitizer",
    "csrf",
    "xss"
  ],
  "type": "module",
