{
  "name": "@samrey/mcp-server",
  "version": "2.0.0",
  "description": "Model Context Protocol (MCP) Server for Samrey Framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vis6ky/Samrey.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/vis6ky/Samrey#readme",
  "bugs": {
    "url": "https://github.com/vis6ky/Samrey/issues"
  },
  "keywords": [
    "samrey",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "gemini"
  ],
  "type": "module",
  "bin": {
    "samrey-mcp": "bin/samrey-mcp.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@samrey/ai": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
