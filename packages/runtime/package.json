{
  "name": "@samrey/runtime",
  "version": "2.0.0",
  "description": "Component lifecycle, static <template> cloning, and surgical DOM hole binding engine for Samrey.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vis6ky/Samrey.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/vis6ky/Samrey#readme",
  "bugs": {
    "url": "https://github.com/vis6ky/Samrey/issues"
  },
  "keywords": [
    "samrey",
    "runtime",
    "dom",
    "template-cloning",
    "bindings"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@samrey/reactivity": "^2.0.0",
    "@samrey/security": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
