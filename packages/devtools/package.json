{
  "name": "@samrey/devtools",
  "version": "1.0.0",
  "description": "Optional runtime DevTools bridge, reactive graph inspection hooks, and transaction event dispatcher.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vis6ky/Samrey.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/vis6ky/Samrey#readme",
  "bugs": {
    "url": "https://github.com/vis6ky/Samrey/issues"
  },
  "keywords": [
    "samrey",
    "devtools",
    "inspection",
    "debugger",
    "profiler"
  ],
  "type": "module",
  "main": "./dist/index.js",
