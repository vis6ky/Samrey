{
  "name": "@samrey/testing",
  "version": "1.0.0",
  "description": "Deterministic unit and integration testing utilities, DOM harnesses, and reactivity flush helpers for Samrey.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vis6ky/Samrey.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/vis6ky/Samrey#readme",
  "bugs": {
    "url": "https://github.com/vis6ky/Samrey/issues"
  },
  "keywords": [
    "samrey",
    "testing",
    "harness",
    "assertions"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@samrey/reactivity": "^1.0.0",
    "@samrey/runtime": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
