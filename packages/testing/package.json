{
  "name": "@gati/testing",
  "version": "1.0.0",
  "description": "Deterministic unit and integration testing utilities, DOM harnesses, and reactivity flush helpers for Gati.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gati-framework/aether.git",
    "directory": "packages/testing"
  },
  "homepage": "https://gati.dev",
  "bugs": {
    "url": "https://github.com/gati-framework/aether/issues"
  },
  "keywords": [
    "aether",
    "testing",
    "harness",
    "assertions"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@gati/reactivity": "^1.0.0",
    "@gati/runtime": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
