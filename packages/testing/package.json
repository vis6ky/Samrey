{
  "name": "@aether/testing",
  "version": "0.1.0",
  "description": "Deterministic unit and integration testing utilities, DOM harnesses, and reactivity flush helpers for Aether.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aether/reactivity": "^0.1.0",
    "@aether/runtime": "^0.1.0"
  },
  "keywords": ["aether", "testing", "harness", "assertions"],
  "author": "Aether Framework Team",
  "license": "Apache-2.0"
}
