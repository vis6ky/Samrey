{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@gati/security": ["./packages/security/src/index.ts"],
      "@gati/reactivity": ["./packages/reactivity/src/index.ts"],
      "@gati/runtime": ["./packages/runtime/src/index.ts"],
      "@gati/compiler": ["./packages/compiler/src/index.ts"],
      "@gati/compiler/*": ["./packages/compiler/*"],
      "@gati/router": ["./packages/router/src/index.ts"],
      "@gati/router/*": ["./packages/router/*"],
      "@gati/http": ["./packages/http/src/index.ts"],
      "@gati/forms": ["./packages/forms/src/index.ts"],
      "@gati/ssr": ["./packages/ssr/src/index.ts"],
      "@gati/testing": ["./packages/testing/src/index.ts"],
      "@gati/cli": ["./packages/cli/src/index.ts"],
      "@gati/cli/*": ["./packages/cli/*"],
      "@gati/devtools": ["./packages/devtools/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
